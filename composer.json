{
    "name": "ernestdefoe/stances",
    "description": "Stances: one-click Agree/Disagree, Yes/No, This-or-That and Rating blocks anywhere in a post, and the side each member took shown beside their replies.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "stances",
        "agree",
        "debate",
        "rating",
        "vote"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/stances",
    "support": {
        "issues": "https://github.com/ernestdefoe/stances/issues",
        "source": "https://github.com/ernestdefoe/stances"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/tags": "Per-tag permissions to add blocks, vote, see voters and moderate",
        "flarum/mentions": "Explain my vote mentions the block's post",
        "flarum/lock": "Locked discussions take no votes",
        "fof/badges": "Badges for stance blocks voted in and added",
        "fof/merge-discussions": "Blocks follow their posts into the merged discussion",
        "flarum/gdpr": "Votes and blocks in a member's data export and erasure"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Stances\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\Stances\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Stances",
            "category": "feature",
            "icon": {
                "name": "fas fa-scale-balanced",
                "backgroundColor": "#2f6db5",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/tags",
                "flarum/mentions",
                "fof/badges",
                "flarum/gdpr",
                "flarum/lock",
                "fof/merge-discussions",
                "flarum/approval"
            ]
        }
    },
    "require-dev": {
        "flarum/approval": "^2.0",
        "flarum/gdpr": "^2.0",
        "flarum/lock": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
